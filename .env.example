# O instalador copia este arquivo para .env. Preencha as chaves somente no .env local.
# Nunca compartilhe o .env nem cole chaves no chat.
# Os nomes dos campos são os mesmos do Criativo AI Studio: quem já tem aquele .env pode copiar os valores.

# ---------- Narração (opcional) ----------
# Sem nenhuma chave, a narração funciona no modo manual:
# o agente entrega o texto e você salva o MP3 em entrada/narracao.mp3.
# Guia: documentacao/configurar-voz.md
# Provedor preferido quando houver mais de um configurado: elevenlabs, fishaudio ou minimax.
VOZ_PROVEDOR=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

MINIMAX_API_KEY=
MINIMAX_VOICE_ID=

# ---------- Legendas (recomendado, gratuito) ----------
# Groq Cloud: transcrição Whisper com tempo palavra por palavra. https://console.groq.com
# Guia: documentacao/configurar-apis.md
GROQ_API_KEY=

# ---------- Publicação no Instagram (opcional) ----------
# Guia: documentacao/configurar-meta.md
META_API_VERSION=v25.0
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=

# Hospedagem pública do vídeo: a Meta só publica a partir de uma URL HTTPS pública.
# Use um repositório público separado e um token fine-grained só dele, com Contents: write.
# Guia: documentacao/configurar-github.md
GITHUB_PAGES_OWNER=
GITHUB_PAGES_REPO=
GITHUB_PAGES_BRANCH=main
GITHUB_PAGES_TOKEN=
GITHUB_PAGES_BASE_URL=

# ---------- Reservadas (ainda não usadas por esta versão) ----------
# Mantidas para compatibilidade com o Criativo AI Studio.
# Gemini: geração de imagens. Pexels: vídeos de stock 9:16.
GEMINI_API_KEY=
PEXELS_API_KEY=
